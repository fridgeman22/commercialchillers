{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "commercialchillers.co.uk" }],
      "destination": "https://www.commercialchillers.co.uk/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin-orders.html"
    }
  ]
}